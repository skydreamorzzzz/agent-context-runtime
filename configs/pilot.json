{
  "schema_version": "1.0",
  "status": "frozen_m3_noop_aa_configuration",
  "provider": "deepseek",
  "model": "deepseek-v4-flash",
  "base_url": "https://api.deepseek.com",
  "credential_source": "env:DEEPSEEK_API_KEY",
  "task_manifest": "tasks/deepseek_add_smoke.json",
  "environment": {
    "workspace": "fresh_public_host_directory",
    "execution_isolation": "linux_user_mount_pid_network_namespaces_bubblewrap",
    "submission_environment": "explicit_minimal_allowlist",
    "network_isolation": "disabled",
    "execution_timeout_seconds": 2,
    "stdout_stderr_limit_bytes": 65536,
    "container_image": {
      "value": null,
      "status": "unknown",
      "reason": "real_smoke_uses_no_container_image",
      "refs": []
    }
  },
  "image_digest": {
    "value": null,
    "status": "unknown",
    "reason": "real_smoke_uses_no_container_image",
    "refs": []
  },
  "code_revision": {
    "capture": "git_rev_parse_HEAD_at_smoke_start"
  },
  "budget": {
    "target_physical_attempts": "1-3",
    "hard_max_physical_attempts": 5
  },
  "price_snapshot": "configs/prices.json",
  "intervention": "noop",
  "cache_isolation": "unsupported",
  "evaluation": "local_add_evaluator_v1",
  "accounting": "not_run"
}
